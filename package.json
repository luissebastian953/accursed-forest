{
  "name": "accursed-forest",
  "private": true,
  "version": "0.1.0",
  "description": "Sawit Simulator — a browser oil-palm plantation management sim",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sweep": "tsx tools/balance-sweep.ts",
    "knip": "knip",
    "commit": "cz",
    "prepare": "lefthook install"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "es-toolkit": "1.52.0",
    "lit-html": "3.3.3",
    "lucide-static": "1.46.0",
    "lz-string": "1.5.0",
    "mitt": "3.0.1",
    "simplex-noise": "4.0.3",
    "three": "0.186.0",
    "web-vitals": "6.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.0",
    "commitizen": "4.3.2",
    "cz-git": "1.14.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "lil-gui": "0.21.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "stats-gl": "4.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "unrs-resolver"
    ]
  }
}
