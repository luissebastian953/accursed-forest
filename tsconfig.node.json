{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@sim/*": ["src/sim/*"],
      "@render/*": ["src/render/*"],
      "@ui/*": ["src/ui/*"],
      "@input/*": ["src/input/*"],
      "@persistence/*": ["src/persistence/*"],
      "@workers/*": ["src/workers/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tools",
    "e2e",
    "tests/tools/comments.test.ts"
  ]
}
