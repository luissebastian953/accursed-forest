# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to ship without
# analytics; the pages then load no third-party script at all.
VITE_GA_ID=

# The site's public origin (e.g. https://sawitsimulator.com). Required for a
# production build that should be indexed: it drives the canonical and hreflang
# tags, absolute Open Graph and JSON-LD URLs, sitemap.xml, and the Sitemap line
# in robots.txt. Leave empty locally: those tags are dropped, no sitemap is
# written, and the build says so. A value that is not a bare http(s) origin
# fails the build.
VITE_SITE_URL=

# Google Search Console ownership, "HTML tag" method: just the content value of
# the <meta name="google-site-verification"> tag it gives you. Added to both
# landing pages. Leave empty if you verify by DNS instead.
VITE_GOOGLE_SITE_VERIFICATION=

# Production builds obfuscate the game's own chunks (three.js is left alone) and
# ship no source maps. Set VITE_OBFUSCATE=0 for a readable build, VITE_SOURCEMAP=1
# to emit maps; both are for debugging a deployed build, not for shipping.
VITE_OBFUSCATE=
VITE_SOURCEMAP=
