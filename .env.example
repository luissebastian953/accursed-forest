# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty ships no analytics.
VITE_GA_ID=

# The site's public origin, e.g. https://sawitsimulator.com. Needed for an
# indexed build: canonical tags, absolute URLs, sitemap. Empty is fine locally.
VITE_SITE_URL=

# Search Console ownership, "HTML tag" method: the content value it gives you.
# Leave empty if you verify by DNS instead.
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership, "HTML Meta Tag" method: the msvalidate.01 content
# value. Leave empty if the site was imported from Search Console instead.
VITE_BING_SITE_VERIFICATION=

# Microsoft Clarity project id (Settings, Overview). Empty ships no Clarity script.
VITE_CLARITY_ID=

# IndexNow key, 8 to 128 of a-z, A-Z, 0-9 and '-'. The build writes /<key>.txt and
# `pnpm indexnow` submits the pages to Bing and the other IndexNow engines.
VITE_INDEXNOW_KEY=

# Where the site is mounted. Empty is a domain root, which is what EdgeOne and
# any real host give you; a project host like GitHub Pages needs the repo name.
VITE_BASE=

# Debugging a deployed build: VITE_SOURCEMAP=1 emits source maps. Not for shipping.
VITE_SOURCEMAP=
