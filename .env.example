# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty ships no analytics.
VITE_GA_ID=

# The site's public origin, e.g. https://sawitsimulator.com. Needed for an
# indexed build: canonical tags, absolute URLs, sitemap. Empty is fine locally.
VITE_SITE_URL=

# Search Console ownership, "HTML tag" method: the content value it gives you.
# Leave empty if you verify by DNS instead.
VITE_GOOGLE_SITE_VERIFICATION=

# Debugging a deployed build: VITE_OBFUSCATE=0 for readable chunks,
# VITE_SOURCEMAP=1 for maps. Neither is for shipping.
VITE_OBFUSCATE=
VITE_SOURCEMAP=
